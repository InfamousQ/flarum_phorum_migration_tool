{
	"name": "infamousq/flarum-phorum-migration-tool",
	"description": "Flarum extension for importing Phorum forum database to existing Flarum installation",
	"type": "flarum-extension",
	"require": {
		"flarum/core": "^1.8",
		"flarum/sticky": "*",
		"flarum/lock": "*",
		"flarum/tags": "*",
		"flarum/markdown": "*",
		"flarum/suspend": "*"
	},
	"require-dev": {
		"flarum/testing": "^1.0.1",
		"phpunit/phpunit": "^9.6"
	},
	"autoload": {
		"psr-4": {"InfamousQ\\FlarumPhorumMigrationTool\\": "src/"}
	},
	"autoload-dev": {
		"psr-4": {"InfamousQ\\FlarumPhorumMigrationTool\\Tests\\": "tests/"}
	},
	"scripts": {
		"test": ["@test:unit", "@test:integration"],
		"test:unit": "phpunit -c tests/phpunit.unit.xml",
		"test:integration": "phpunit -c tests/phpunit.integration.xml",
		"test:setup": "@php tests/integration/setup.php",
		"benchmark": ["Composer\\Config::disableProcessTimeout", "phpunit -c tests/phpunit.benchmark.xml"]
	},
	"extra": {
		"flarum-extension": {
			"title": "Phorum migration tool",
			"icon": {
				"name": "fas fa-smile",
				"backgroundColor": "#238c59",
				"color": "#fff"
			}
		}
	}
}
